# ---------------------------------------------------------------------------
# Copy to .env and fill in. NEVER commit a real .env (it is in .gitignore).
# ---------------------------------------------------------------------------

# Free key from Google AI Studio: https://aistudio.google.com/apikey
# The app still boots without it (health check works, RAG uses keyword
# search), but POST /tickets will return 503 until a key is set.
GEMINI_API_KEY=

# "Flash" models are the fast/cheap tier and are available on the free tier.
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

PORT=3000

# Per-LLM-call timeout and retry policy (429 / 5xx are retried with backoff).
LLM_TIMEOUT_MS=30000
LLM_MAX_RETRIES=3
LLM_RETRY_BASE_DELAY_MS=1000

# RAG
KB_DIR=kb
RAG_TOP_K=3
# Set to false to skip embeddings entirely and use keyword search only
# (saves free-tier quota while developing).
RAG_USE_EMBEDDINGS=true

# Agent loop guard: max model<->tool round trips per specialist run.
AGENT_MAX_TOOL_STEPS=4
